# KestrelFlow Configuration Template
# Copy this file to .env and adjust values for your environment.

# Path to optional JSON configuration file
# KESTREL_CONFIG=config.json

# Server HTTP Host and Port
KESTREL_SERVER_HOST=127.0.0.1
KESTREL_SERVER_PORT=8080

# Storage Backend Type: "memory" (default for local/testing) or "postgres"
KESTREL_DB_TYPE=memory

# PostgreSQL Connection DSN (required when KESTREL_DB_TYPE=postgres)
# Example: postgres://kestrel_user:kestrel_password@localhost:5432/kestrel_db?sslmode=disable
KESTREL_DB_DSN=

# Worker Pool Concurrency (number of parallel step execution goroutines)
KESTREL_WORKER_CONCURRENCY=4
